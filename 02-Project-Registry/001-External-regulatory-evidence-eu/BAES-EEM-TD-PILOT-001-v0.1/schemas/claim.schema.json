{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim",
  "type": "object",
  "required": [
    "entity_id",
    "entity_type",
    "schema_version",
    "object_version",
    "dataset_id",
    "created_at",
    "record_status",
    "claim_id",
    "proposition",
    "initial_state"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "const": "Claim"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "object_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "dataset_id": {
      "const": "BAES-EEM-TD-PILOT-001"
    },
    "fixture_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_status": {
      "enum": [
        "Draft",
        "Active",
        "Superseded",
        "Retracted",
        "Invalidated"
      ]
    },
    "claim_id": {
      "type": "string"
    },
    "proposition": {
      "type": "string"
    },
    "initial_state": {
      "enum": [
        "Not Started",
        "Ready",
        "In Progress",
        "Finding Established",
        "Finding Partially Established",
        "Unproven",
        "Finding Not Established",
        "On Hold",
        "Stopped",
        "Not Applicable",
        "Superseded"
      ]
    }
  },
  "additionalProperties": false
}
