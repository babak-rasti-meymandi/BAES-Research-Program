{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "State Transition",
  "type": "object",
  "required": [
    "entity_id",
    "entity_type",
    "schema_version",
    "object_version",
    "dataset_id",
    "created_at",
    "record_status",
    "transition_id",
    "subject_ref",
    "from_state",
    "to_state",
    "basis_refs",
    "transition_time"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "const": "StateTransition"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "object_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "dataset_id": {
      "const": "BAES-EEM-TD-PILOT-001"
    },
    "fixture_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_status": {
      "enum": [
        "Draft",
        "Active",
        "Superseded",
        "Retracted",
        "Invalidated"
      ]
    },
    "transition_id": {
      "type": "string"
    },
    "subject_ref": {
      "type": "object",
      "required": [
        "entity_type",
        "entity_id",
        "entity_version"
      ],
      "properties": {
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "from_state": {
      "type": "string"
    },
    "to_state": {
      "type": "string"
    },
    "basis_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_type",
          "entity_id",
          "entity_version"
        ],
        "properties": {
          "entity_type": {
            "type": "string",
            "minLength": 1
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "entity_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "transition_time": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
