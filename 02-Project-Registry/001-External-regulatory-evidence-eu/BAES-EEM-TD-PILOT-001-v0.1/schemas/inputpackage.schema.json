{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Input Package",
  "type": "object",
  "required": [
    "entity_id",
    "entity_type",
    "schema_version",
    "object_version",
    "dataset_id",
    "created_at",
    "record_status",
    "visibility",
    "items"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "const": "InputPackage"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "object_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "dataset_id": {
      "const": "BAES-EEM-TD-PILOT-001"
    },
    "fixture_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_status": {
      "enum": [
        "Draft",
        "Active",
        "Superseded",
        "Retracted",
        "Invalidated"
      ]
    },
    "visibility": {
      "const": "Model-Visible"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input_id",
          "content_type",
          "content",
          "source_attribution"
        ],
        "properties": {
          "input_id": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "source_attribution": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
