{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Lineage Assessment",
  "type": "object",
  "required": [
    "entity_id",
    "entity_type",
    "schema_version",
    "object_version",
    "dataset_id",
    "created_at",
    "record_status",
    "lineage_id",
    "declared_lineage",
    "established_lineage",
    "assessment_status"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "const": "SourceLineageAssessment"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "object_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "dataset_id": {
      "const": "BAES-EEM-TD-PILOT-001"
    },
    "fixture_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_status": {
      "enum": [
        "Draft",
        "Active",
        "Superseded",
        "Retracted",
        "Invalidated"
      ]
    },
    "lineage_id": {
      "type": "string"
    },
    "declared_lineage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "established_lineage": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "assessment_status": {
      "enum": [
        "Not Assessed",
        "Partially Established",
        "Established",
        "Not Established",
        "Conflicted"
      ]
    }
  },
  "additionalProperties": false
}
