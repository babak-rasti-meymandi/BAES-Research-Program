{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baes.example/schemas/entity-reference.schema.json",
  "type": "object",
  "required": [
    "entity_type",
    "entity_id",
    "entity_version"
  ],
  "properties": {
    "entity_type": {
      "type": "string",
      "minLength": 1
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    }
  },
  "additionalProperties": false
}
