{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataset",
  "type": "object",
  "required": [
    "entity_id",
    "entity_type",
    "schema_version",
    "object_version",
    "dataset_id",
    "created_at",
    "record_status",
    "dataset_name",
    "dataset_version",
    "status",
    "fixture_refs"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "const": "Dataset"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "object_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "dataset_id": {
      "const": "BAES-EEM-TD-PILOT-001"
    },
    "fixture_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_status": {
      "enum": [
        "Draft",
        "Active",
        "Superseded",
        "Retracted",
        "Invalidated"
      ]
    },
    "dataset_name": {
      "type": "string"
    },
    "dataset_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "Draft",
        "Under Validation",
        "Validated for Pilot Execution",
        "Validated with Restrictions",
        "On Hold",
        "Rejected",
        "Superseded"
      ]
    },
    "fixture_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_type",
          "entity_id",
          "entity_version"
        ],
        "properties": {
          "entity_type": {
            "type": "string",
            "minLength": 1
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "entity_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
