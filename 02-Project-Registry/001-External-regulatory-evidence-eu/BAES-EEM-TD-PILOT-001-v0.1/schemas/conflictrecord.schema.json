{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conflict Record",
  "type": "object",
  "required": [
    "entity_id",
    "entity_type",
    "schema_version",
    "object_version",
    "dataset_id",
    "created_at",
    "record_status",
    "conflict_id",
    "proposition_refs",
    "comparability_status",
    "disposition",
    "limitations"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "const": "ConflictRecord"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "object_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "dataset_id": {
      "const": "BAES-EEM-TD-PILOT-001"
    },
    "fixture_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_status": {
      "enum": [
        "Draft",
        "Active",
        "Superseded",
        "Retracted",
        "Invalidated"
      ]
    },
    "conflict_id": {
      "type": "string"
    },
    "proposition_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_type",
          "entity_id",
          "entity_version"
        ],
        "properties": {
          "entity_type": {
            "type": "string",
            "minLength": 1
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "entity_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "comparability_status": {
      "enum": [
        "Not Assessed",
        "Comparable",
        "Partially Comparable",
        "Not Comparable",
        "Unresolved"
      ]
    },
    "disposition": {
      "enum": [
        "Not Assessed",
        "Reconciled",
        "Unresolved",
        "Non-material",
        "Partially Reconciled"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
