{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expected Behavior",
  "type": "object",
  "required": [
    "entity_id",
    "entity_type",
    "schema_version",
    "object_version",
    "dataset_id",
    "created_at",
    "record_status",
    "behaviors",
    "global_constraints"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "const": "ExpectedBehaviorSet"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "object_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "dataset_id": {
      "const": "BAES-EEM-TD-PILOT-001"
    },
    "fixture_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_status": {
      "enum": [
        "Draft",
        "Active",
        "Superseded",
        "Retracted",
        "Invalidated"
      ]
    },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "behavior_id",
          "target_claim_ref",
          "expected_state",
          "conditions",
          "prohibited_inferences"
        ],
        "properties": {
          "behavior_id": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "target_claim_ref": {
            "type": "object",
            "required": [
              "entity_type",
              "entity_id",
              "entity_version"
            ],
            "properties": {
              "entity_type": {
                "type": "string",
                "minLength": 1
              },
              "entity_id": {
                "type": "string",
                "minLength": 1
              },
              "entity_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+$"
              }
            },
            "additionalProperties": false
          },
          "expected_state": {
            "enum": [
              "Not Started",
              "Ready",
              "In Progress",
              "Finding Established",
              "Finding Partially Established",
              "Unproven",
              "Finding Not Established",
              "On Hold",
              "Stopped",
              "Not Applicable",
              "Superseded"
            ]
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prohibited_inferences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "global_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
