{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-Claim Assessment",
  "type": "object",
  "required": [
    "entity_id",
    "entity_type",
    "schema_version",
    "object_version",
    "dataset_id",
    "created_at",
    "record_status",
    "relationship_assessment_id",
    "evidence_ref",
    "claim_ref",
    "assessment_version",
    "applicability_status",
    "sufficiency_status",
    "relationship_status",
    "basis_refs",
    "limitations"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "const": "EvidenceClaimAssessment"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "object_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "dataset_id": {
      "const": "BAES-EEM-TD-PILOT-001"
    },
    "fixture_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "record_status": {
      "enum": [
        "Draft",
        "Active",
        "Superseded",
        "Retracted",
        "Invalidated"
      ]
    },
    "relationship_assessment_id": {
      "type": "string"
    },
    "evidence_ref": {
      "type": "object",
      "required": [
        "entity_type",
        "entity_id",
        "entity_version"
      ],
      "properties": {
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "claim_ref": {
      "type": "object",
      "required": [
        "entity_type",
        "entity_id",
        "entity_version"
      ],
      "properties": {
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "assessment_version": {
      "type": "string"
    },
    "applicability_status": {
      "enum": [
        "Not Assessed",
        "Under Assessment",
        "Usable for Claim",
        "Usable with Restrictions",
        "Insufficient for Claim",
        "Not Applicable to Claim",
        "Conflicted for Claim",
        "Rejected for Specific Claim"
      ]
    },
    "sufficiency_status": {
      "enum": [
        "Not Assessed",
        "Sufficient",
        "Insufficient",
        "Partially Sufficient",
        "Unproven"
      ]
    },
    "relationship_status": {
      "enum": [
        "Not Assessed",
        "Under Assessment",
        "Established",
        "Not Established",
        "Conflicted",
        "Superseded"
      ]
    },
    "basis_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_type",
          "entity_id",
          "entity_version"
        ],
        "properties": {
          "entity_type": {
            "type": "string",
            "minLength": 1
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "entity_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
